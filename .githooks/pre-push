#!/bin/bash

# Pre-push hook: auto-bump version before pushing
# This runs 'npm version patch' to increment the patch version in package.json
# and create a commit + tag

echo "📦 Auto-bumping version..."
npm version patch

# If npm version fails, abort the push
if [ $? -ne 0 ]; then
  echo "❌ Version bump failed, aborting push."
  exit 1
fi

echo "✅ Version bumped successfully!"
exit 0

